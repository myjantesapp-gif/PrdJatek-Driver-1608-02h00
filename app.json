{
  "expo": {
    "name": "Jatek Driver",
    "slug": "jatekdriver",
    "owner": "jateksys",
    "version": "3.10.1811",
    "orientation": "portrait",
    "icon": "./assets/driver-icon.png",
    "scheme": "jatekdriver",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1B5D1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jatek.driver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/driver-icon-foreground.png",
        "backgroundColor": "#F1B5D1",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.jatek.driver",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 28
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "orders",
          "icon": "./assets/notification-icon.png",
          "color": "#CF346E"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jatek Driver utilise votre position pour suivre vos livraisons."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "38b2a449-33b2-4549-8f5f-c7f535d41a34"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/38b2a449-33b2-4549-8f5f-c7f535d41a34"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}

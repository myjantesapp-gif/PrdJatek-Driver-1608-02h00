{
  "expo": {
    "name": "Jatek Driver",
    "slug": "jatekdriver",
    "owner": "jateksys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jatekdriver",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jatek.driver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.jatek.driver",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 25
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "orders",
          "color": "#E91E8C"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Jatek Driver utilise votre position pour suivre vos livraisons."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "38b2a449-33b2-4549-8f5f-c7f535d41a34"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/38b2a449-33b2-4549-8f5f-c7f535d41a34"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}


{
  "cli": {
    "version": ">= 14.7.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "npm_config_frozen_lockfile": "false",
        "PNPM_VERSION": "10.26.1",
        "EXPO_PUBLIC_PROJECT_ID": "f477d6ab-d379-4b47-a22d-03c45763cc11",
        "EXPO_OWNER": "jatekplatform",
        "EXPO_SLUG": "jatekdriver"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "credentialsSource": "remote",
      "env": {
        "npm_config_frozen_lockfile": "false",
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_PUBLIC_PROJECT_ID": "f477d6ab-d379-4b47-a22d-03c45763cc11",
        "PNPM_VERSION": "10.26.1",
        "EXPO_OWNER": "jatekplatform",
        "EXPO_SLUG": "jatekdriver"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "npm_config_frozen_lockfile": "false",
        "EXPO_PUBLIC_DOMAIN": "ma.jatek.app",
        "EXPO_PUBLIC_API_URL": "https://ma.jatek.app",
        "EXPO_PUBLIC_PROJECT_ID": "f477d6ab-d379-4b47-a22d-03c45763cc11",
        "PNPM_VERSION": "10.26.1",
        "EXPO_OWNER": "jatekplatform",
        "EXPO_SLUG": "jatekdriver"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
